[Unit]
Description=Local Fedora development shell on tty1
After=systemd-user-sessions.service

[Service]
Type=idle
ExecStart=-/usr/bin/bash --login
StandardInput=tty-force
StandardOutput=tty
StandardError=tty
TTYPath=/dev/tty1
TTYReset=yes
TTYVHangup=yes
Restart=always
RestartSec=1

[Install]
WantedBy=multi-user.target
